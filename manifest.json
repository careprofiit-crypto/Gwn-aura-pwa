{
  "name": "GWN Aura",
  "short_name": "GWN Aura",
  "description": "The smarter way to move your money - fast transfers, airtime, bills, and savings.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "dir": "ltr",
  "lang": "en",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone"
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        {
          "pathname": "/"
        }
      ]
    },
    "new_tab_button": {
      "url": "/"
    }
  },
  "orientation": "portrait",
  "background_color": "#0a0a0c",
  "theme_color": "#d4af37",
  "categories": [
    "finance"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://gwnaura.vercel.app/manifest.json"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://gwnaura-app.blogspot.com"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GWN Aura Mobile App"
    },
    {
      "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GWN Aura Desktop App"
    }
  ],
  "shortcuts": [
    {
      "name": "Send Money",
      "short_name": "Send",
      "description": "Transfer funds instantly",
      "url": "/?action=send",
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fund Account",
      "short_name": "Fund",
      "description": "Top up your wallet balance",
      "url": "/?action=fund",
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "GWN Aura Balance",
      "short_name": "Balance",
      "description": "View your GWN Aura quick actions",
      "tag": "gwn-balance-widget",
      "template": "gwn-template",
      "ms_ac_template": "https://gwnaura.vercel.app/widget.json",
      "data": "https://gwnaura.vercel.app/manifest.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
          "sizes": "192x192",
          "label": "Widget View"
        }
      ],
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/careprofiit-crypto/Gwn-aura-pwa/main/192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gwnaura",
      "url": "/?pay=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}
