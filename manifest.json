{
  "name": "GWN Aura",
  "short_name": "GWN Aura",
  "description": "The smarter way to move your money - fast transfers, airtime, bills, and savings.",
  "start_url": "/",
  "scope": "/",
  "id": "gwnaura",
  "dir": "ltr",
  "lang": "en",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "window-controls-overlay"
  ],
  "orientation": "portrait",
  "background_color": "#0a0a0c",
  "theme_color": "#d4af37",
  "categories": [
    "finance"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://gwn-aura-pi.vercel.app/manifest.json"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "scope_extensions": [
    {
      "origin": "https://www.gwnaura.dpdns.org"
    },
    {
      "origin": "https://gwn-aura-pi.vercel.app"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Send Money",
      "short_name": "Send",
      "description": "Transfer funds instantly",
      "url": "/?action=send",
      "icons": [
        {
          "src": "/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fund Account",
      "short_name": "Fund",
      "description": "Top up your wallet balance",
      "url": "/?action=fund",
      "icons": [
        {
          "src": "/192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "GWN Aura Mobile"
    },
    {
      "src": "/512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "GWN Aura Desktop"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+gwnaura",
      "url": "/?pay=%s"
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "Quick Balance",
      "description": "Check your wallet balance",
      "tag": "gwn-balance",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/512.png",
          "sizes": "512x512",
          "label": "GWN Aura Widget"
        }
      ]
    }
  ]
}